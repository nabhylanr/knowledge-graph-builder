NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
INDEX_NAME=vector
TIMEOUT=5000

EMBEDDINGS_TYPE=ollama
EMBEDDINGS_MODEL_NAME=qwen3-embedding:0.6b
EMBEDDINGS_API_KEY=none
EMBEDDINGS_DEPLOYMENT=none
# Remote Ollama for embeddings (e.g. a Tailscale host like
# http://100.118.203.111:11434). "none"/unset falls back to local localhost:11434 —
# which only works if that machine has EMBEDDINGS_MODEL_NAME pulled.
EMBEDDINGS_ENDPOINT=none

RE_MODEL_TYPE=ollama
RE_MODEL_NAME=qwen3:4b
RE_API_KEY=none
RE_MODEL_TEMPERATURE=0.0
RE_MODEL_DEPLOYMENT=none
RE_MODEL_ENDPOINT=none

# --- Extraction speed knobs (optional) ---
# 1 = skip tool/function calling and parse raw JSON directly. Set for models whose
# structured-output/tool-calling is unreliable (e.g. qwen3-vl); leave unset for
# OpenAI/Groq where tool-calling works.
# CHANGED 1 -> 0: this was set for qwen3-vl and never reverted after switching to a
# model whose tool-calling works. With RAW_ONLY=1 the schema is not enforced at the
# API level, so a malformed JSON response silently drops that chunk.
# Prime suspect for the thin graph.
EXTRACTOR_RAW_ONLY=0
# Number of chunks extracted concurrently. 1 = sequential. Raise for a strong
# server, lower if the LLM backend can't keep up.
EXTRACTOR_MAX_WORKERS=4
# 1 = append qwen3's /no_think switch to suppress its reasoning block. Faster but
# can reduce extraction quality — benchmark before enabling.
EXTRACTOR_NO_THINK=0

GATE_NLI_MODEL=qwen3:4b
GATE_NLI_ENDPOINT=none

CLASSIFICATION_MODEL_TYPE=ollama
CLASSIFICATION_MODEL_NAME=qwen3:4b
CLASSIFICATION_MODEL_ENDPOINT=none

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
SUPABASE_BUCKET=chunks
CHUNKS_DEST_DIR=chunks_data
# Folder a download lands in when nothing identifies the document — paper|meeting
DEFAULT_DOC_TYPE=paper
# Which documents are already in the graph (gitignored, local to this machine)
BUILD_LEDGER_PATH=build_ledger.json

SUPABASE_ANON_KEY=anon_key_here
SUPABASE_EMAIL=producer@example.com
SUPABASE_PASSWORD=producer_password_here