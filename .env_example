NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
INDEX_NAME=vector
TIMEOUT=5000

EMBEDDINGS_TYPE=ollama
EMBEDDINGS_MODEL_NAME=qwen3-embedding:0.6b
EMBEDDINGS_API_KEY=none
EMBEDDINGS_DEPLOYMENT=none
EMBEDDINGS_ENDPOINT=none

RE_MODEL_TYPE=ollama
RE_MODEL_NAME=qwen3:4b
RE_API_KEY=none
RE_MODEL_TEMPERATURE=0.0
RE_MODEL_DEPLOYMENT=none
RE_MODEL_ENDPOINT=none

EXTRACTOR_RAW_ONLY=0
EXTRACTOR_MAX_WORKERS=4
EXTRACTOR_NO_THINK=0

GATE_NLI_MODEL=qwen3:4b
GATE_NLI_ENDPOINT=none

CLASSIFICATION_MODEL_TYPE=ollama
CLASSIFICATION_MODEL_NAME=qwen3:4b
CLASSIFICATION_MODEL_ENDPOINT=none

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
SUPABASE_BUCKET=chunks
CHUNKS_DEST_DIR=chunks_data
# One manifest table per doc_type; the table a row is in decides the local
# folder. Override only if this instance names them differently.
SUPABASE_PAPER_TABLE=paper_chunk_uploads
SUPABASE_MEETING_TABLE=meeting_chunk_uploads
# Meeting chunks with less speech than this are stored and embedded but never
# sent to the extraction LLM (0 = extract everything). See
# DEFAULT_ELIGIBLE_MIN_CHARS in src/ingestion/meeting_chunks.py for why it is 70.
MEETING_ELIGIBLE_MIN_CHARS=70
BUILD_LEDGER_PATH=build_ledger.json

SUPABASE_ANON_KEY=anon_key_here
SUPABASE_EMAIL=producer@example.com
SUPABASE_PASSWORD=producer_password_here