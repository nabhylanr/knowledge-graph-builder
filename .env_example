# ---- Neo4j ----
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
INDEX_NAME=vector
TIMEOUT=5000

# ---- Embeddings (used to vectorize each chunk) ----
# ollama runs locally; mxbai-embed-large is small enough for a laptop.
# Swap type/model for openai/azure-openai/trf if you prefer a cloud embedder.
EMBEDDINGS_TYPE=ollama
EMBEDDINGS_MODEL_NAME=mxbai-embed-large
EMBEDDINGS_API_KEY=none
EMBEDDINGS_DEPLOYMENT=none
EMBEDDINGS_ENDPOINT=none

# ---- Graph extraction LLM (RE = relation extraction) ----
# Use Groq cloud for extraction — a 70B model gives much cleaner graphs and
# does not need local GPU/RAM.
RE_MODEL_TYPE=groq
RE_MODEL_NAME=llama-3.3-70b-versatile
RE_API_KEY=<your_groq_api_key>
RE_MODEL_TEMPERATURE=0.0
RE_MODEL_DEPLOYMENT=none
RE_MODEL_ENDPOINT=none
