NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
INDEX_NAME=vector
TIMEOUT=5000

EMBEDDINGS_TYPE=ollama
EMBEDDINGS_MODEL_NAME=mxbai-embed-large
EMBEDDINGS_API_KEY=none
EMBEDDINGS_DEPLOYMENT=none
EMBEDDINGS_ENDPOINT=none

RE_MODEL_TYPE=ollama
RE_MODEL_NAME=qwen2.5:3b
RE_API_KEY=api_key_here
RE_MODEL_TEMPERATURE=0.0
RE_MODEL_DEPLOYMENT=none
RE_MODEL_ENDPOINT=none

# --- Extraction speed knobs (optional) ---
# 1 = skip tool/function calling and parse raw JSON directly. Set for models whose
# structured-output/tool-calling is unreliable (e.g. qwen3-vl); leave unset for
# OpenAI/Groq where tool-calling works.
EXTRACTOR_RAW_ONLY=0
# Number of chunks extracted concurrently. 1 = sequential. Raise for a strong
# server, lower if the LLM backend can't keep up.
EXTRACTOR_MAX_WORKERS=4
# 1 = append qwen3's /no_think switch to suppress its reasoning block. Faster but
# can reduce extraction quality — benchmark before enabling.
EXTRACTOR_NO_THINK=0